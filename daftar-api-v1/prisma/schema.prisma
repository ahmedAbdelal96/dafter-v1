// ============================================================
// PUSH NOTIFICATIONS
// ============================================================

// Stores Expo push tokens per user per device.
// One user can have many devices (phone + tablet, iOS + Android).
// Tokens are deactivated on logout rather than deleted (preserves history).
model DeviceToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation("UserDeviceTokens", fields: [userId], references: [id], onDelete: Cascade)

  // Expo push token format: "ExponentPushToken[xxxx]"
  // Unique constraint prevents duplicate registrations for same device.
  token String @unique

  // Client platform — used for analytics and future platform-specific delivery
  platform String // 'ios' | 'android' | 'web'

  // Human-readable device name sent from the app (e.g. "iPhone 15 Pro")
  deviceName String?

  // false after explicit logout/unregister — kept for audit trail
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive]) // fast: get all active tokens for a user
  @@index([token]) // fast: look up token for deduplication
}

// In-app notification records.
// Every push notification has a corresponding DB record for:
//   1. In-app notification feed (unread badge, history list)
//   2. Audit trail (when was it created/sent/read)
//   3. Retry logic (sentAt=null means not yet pushed)
model Notification {
  id String @id @default(uuid()) @db.Uuid

  // Personal notification — always targeted at a specific user
  userId String @db.Uuid
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  // Optional company scope for multi-tenant context
  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Notification type for client-side routing/icons
  // Convention: '{module}.{event}', e.g. 'ledger.created', 'invoice.overdue'
  type String

  // Content
  title String // Push title and in-app heading
  body  String // Push body and in-app description

  // Extra payload for deep-linking on the mobile side
  // e.g. { screen: 'LedgerDetail', entryId: 'uuid' }
  data Json @default("{}")

  // State tracking
  readAt DateTime? // null = unread
  sentAt DateTime? // null = push not yet sent (queued or pending)

  createdAt DateTime @default(now())

  @@index([userId, readAt]) // fast: unread count + filter unread
  @@index([userId, createdAt(sort: Desc)]) // fast: notification feed
  @@index([companyId, createdAt(sort: Desc)]) // fast: company-level queries
}

// ============================================================
// PHASE 3: EXPENSES (المصروفات)
// ============================================================
//
// Design decisions:
// - Each expense belongs to a Company; commercial parties are authoritative
//   BusinessPartner rows and are not embedded as legacy supplier records.
// - category (ExpenseCategory enum) drives UI grouping and pie-chart analytics.
// - referenceNumber is free-text (receipt / invoice number from vendor).
// - Expenses remain operational records until the expense posting workflow is introduced.
//   (A future migration can add a journal-entry bridge if double-entry is needed.)
// - Soft-deleted with isDeleted + deletedAt for full auditability.
// ============================================================

model Expense {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  category    ExpenseCategory
  amount      Decimal         @db.Decimal(14, 2)
  expenseDate DateTime        @db.Date

  // Human-readable note; stored in the expense itself (not i18n)
  description String? @db.VarChar(500)

  // Optional receipt / vendor invoice reference for physical paper trail
  referenceNumber String? @db.VarChar(100)

  // Cash / bank transfer / cheque / etc. — free text for flexibility
  paymentMethod String? @db.VarChar(100)

  // Extra internal notes (separate from public description)
  notes String? @db.VarChar(1000)

  createdById String @db.Uuid
  createdBy   User   @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Key query patterns:
  // 1. List all expenses for a company sorted by date (default view)
  // 2. Filter by category (category breakdown)
  // 3. Filter by category and date range
  // 4. Date-range reports
  @@index([companyId, isDeleted, expenseDate(sort: Desc)]) // default list
  @@index([companyId, isDeleted, category]) // category filter
  @@index([companyId, createdAt(sort: Desc)]) // audit sort
}

// ============================================================
// PHASE 4: PRODUCTS / SERVICES CATALOG (كتالوج المنتجات والخدمات)
// ============================================================
//
// Design decisions:
// - `sku` is optional but unique per company when provided.
//   PostgreSQL treats NULLs as distinct in UNIQUE constraints, so multiple
//   products with sku = null are allowed — enforcement happens at the DB level.
// - `category` is a free-text string (not an enum) — merchants have wildly
//   different product taxonomies; a rigid enum would hurt adoption.
// - `isActive` provides soft-disable: hides from catalog pickers.
// - `unitPrice` stored at Decimal(14,2) — never do arithmetic in JS/TS.
// - SalesInvoiceLine keeps its own immutable product snapshot.
// - Soft-deleted with isDeleted + deletedAt for full auditability.
// ============================================================

model Product {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(200)
  description String? @db.VarChar(1000)

  // كود المنتج — optional, unique per company (when provided)
  sku String? @db.VarChar(50)

  // Free-text category (e.g. "إلكترونيات", "ملابس", "خدمات") — not an enum by design
  category String? @db.VarChar(100)

  // Unit of measure (قطعة / كيلو / متر / خدمة / etc.) — free-text
  unit String? @db.VarChar(20)

  unitPrice Decimal @db.Decimal(14, 2)

  // Soft disable: hides from catalog picker without removing history
  isActive Boolean @default(true)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  createdById String @db.Uuid
  createdBy   User   @relation("ProductCreatedBy", fields: [createdById], references: [id])

  salesInvoiceLines    SalesInvoiceLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  supplierInvoiceLines SupplierInvoiceLine[]

  // SKU uniqueness: Postgres UNIQUE treats NULLs as distinct — multiple products
  // with sku = null are allowed; sku conflicts are caught at the app layer first
  // for a friendly Arabic error message before hitting DB.
  @@unique([companyId, sku])
  @@unique([id, companyId])
  // Key query patterns:
  // 1. Active product catalog (default view in picker)
  // 2. Filter by category
  // 3. Name search (ILIKE)
  @@index([companyId, isDeleted, isActive]) // catalog list: active only
  @@index([companyId, isDeleted, category]) // category filter
  @@index([companyId, isDeleted, name]) // name search support
  @@index([companyId, isDeleted, sku]) // SKU search support (B3)
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  scope          String            @db.VarChar(120)
  operationType  String            @db.VarChar(80)
  actorUserId    String            @db.Uuid
  companyId      String            @db.Uuid
  idempotencyKey String            @db.VarChar(128)
  requestHash    String            @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  errorCode      String?           @db.VarChar(120)
  lockedUntil    DateTime?
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([companyId, operationType, idempotencyKey])
  @@index([expiresAt])
  @@index([companyId, operationType, status])
  @@map("idempotency_records")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

// ============================================================
//
// Design decisions:
// - Invoice stores a snapshot of party data (name, phone, address) at
//   creation time so the document remains accurate even if the party record
//   changes later.
// - InvoiceItem holds a snapshot of description + prices. productId is a
//   soft link for historical traceability; deleting a product NULLs it out
//   (SetNull) without breaking existing invoices.
// - invoiceNumber is server-assigned (INV-YYYY-NNNN). Generation runs inside
//   a $transaction to prevent duplicates under concurrent writes. A unique
//   constraint per company enforces DB-level integrity.
// - deferredSaleId is an optional @unique FK: one sale → at most one invoice.
//   Cancelling (soft-deleting) the invoice does NOT reverse the deferred sale.
// - taxAmount is stored separately so the net and gross totals are clear.
// - Soft-delete only for full auditability.
// ============================================================

// ============================================================
// B03: AUTHORITATIVE SALES DOCUMENTS
// ============================================================

model SalesDocumentSequence {
  id           String            @id @default(uuid()) @db.Uuid
  companyId    String            @db.Uuid
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId String            @db.Uuid
  fiscalYear   FiscalYear        @relation(fields: [fiscalYearId, companyId], references: [id, companyId], onDelete: Restrict)
  documentType SalesDocumentType
  nextValue    Int               @default(1)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([companyId, fiscalYearId, documentType])
  @@index([companyId, documentType])
}

model SalesInvoice {
  id                      String             @id @default(uuid()) @db.Uuid
  companyId               String             @db.Uuid
  company                 Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartnerId       String             @db.Uuid
  businessPartner         BusinessPartner    @relation(fields: [businessPartnerId, companyId], references: [id, companyId], onDelete: Restrict)
  status                  SalesInvoiceStatus @default(DRAFT)
  invoiceNumber           String?            @db.VarChar(40)
  documentDate            DateTime           @db.Date
  postingDate             DateTime?          @db.Date
  transactionCurrencyCode String             @db.Char(3)
  transactionCurrency     Currency           @relation("SalesInvoiceTransactionCurrency", fields: [transactionCurrencyCode], references: [code], onDelete: Restrict)
  exchangeRate            Decimal            @db.Decimal(19, 8)
  paymentTermId           String?            @db.Uuid
  paymentTerm             PaymentTerm?       @relation(fields: [paymentTermId, companyId], references: [id, companyId], onDelete: Restrict)
  customerReference       String?            @db.VarChar(120)
  notes                   String?            @db.VarChar(2000)

  subtotal         Decimal @db.Decimal(19, 4)
  discountTotal    Decimal @db.Decimal(19, 4)
  taxableBaseTotal Decimal @db.Decimal(19, 4)
  taxTotal         Decimal @db.Decimal(19, 4)
  grandTotal       Decimal @db.Decimal(19, 4)

  partnerCodeSnapshot           String  @db.VarChar(40)
  partnerNameSnapshot           String  @db.VarChar(200)
  partnerLegalNameSnapshot      String?
  taxRegistrationNumberSnapshot String?
  billingAddressSnapshot        Json?

  postedById          String?            @db.Uuid
  postedBy            User?              @relation("SalesInvoicePostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  postedAt            DateTime?
  journalEntryId      String?            @db.Uuid
  journalEntry        JournalEntry?      @relation("SalesInvoiceJournalEntry", fields: [journalEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  receivableAccountId String?            @db.Uuid
  receivableAccount   AccountingAccount? @relation("SalesInvoiceReceivableAccount", fields: [receivableAccountId, companyId], references: [id, companyId], onDelete: Restrict)
  idempotencyKey      String?            @db.VarChar(128)
  requestHash         String?            @db.Char(64)
  createdById         String             @db.Uuid
  createdBy           User               @relation("SalesInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  lines           SalesInvoiceLine[]
  paymentSchedule SalesInvoicePaymentSchedule[]
  creditNotes     SalesCreditNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, companyId])
  @@unique([companyId, invoiceNumber])
  @@unique([journalEntryId, companyId])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, status, documentDate])
  @@index([companyId, businessPartnerId, documentDate])
  @@index([companyId, postingDate])
  @@index([companyId, transactionCurrencyCode])
  @@index([companyId, receivableAccountId])
}

model SalesInvoiceLine {
  id                         String             @id @default(uuid()) @db.Uuid
  companyId                  String             @db.Uuid
  salesInvoiceId             String             @db.Uuid
  salesInvoice               SalesInvoice       @relation(fields: [salesInvoiceId, companyId], references: [id, companyId], onDelete: Cascade)
  sequence                   Int
  productId                  String?            @db.Uuid
  product                    Product?           @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)
  descriptionSnapshot        String             @db.VarChar(500)
  quantity                   Decimal            @db.Decimal(19, 6)
  unitPrice                  Decimal            @db.Decimal(19, 6)
  discountType               SalesDiscountType  @default(NONE)
  discountValue              Decimal            @db.Decimal(19, 6)
  grossBeforeDiscount        Decimal            @db.Decimal(19, 4)
  discountAmount             Decimal            @db.Decimal(19, 4)
  taxableBase                Decimal            @db.Decimal(19, 4)
  taxAmount                  Decimal            @db.Decimal(19, 4)
  lineTotal                  Decimal            @db.Decimal(19, 4)
  revenueAccountId           String?            @db.Uuid
  revenueAccount             AccountingAccount? @relation("SalesInvoiceLineRevenueAccount", fields: [revenueAccountId, companyId], references: [id, companyId], onDelete: Restrict)
