}

enum AccountingConfigAccountKey {
  RECEIVABLE
  PAYABLE
  INCOME
  EXPENSE
  RETAINED_EARNINGS
  EXCHANGE_GAIN
  EXCHANGE_LOSS
  ROUNDING
  TAX_PAYABLE
  TAX_RECOVERABLE
  INVENTORY
  COGS
}

enum AccountingConfigJournalKey {
  GENERAL
  SALES
  PURCHASE
  CASH
  BANK
  EXCHANGE_DIFFERENCE
}

enum PaymentTermLineType {
  PERCENT
  BALANCE
}

enum AccountingSetupStatus {
  NOT_CONFIGURED
  IN_PROGRESS
  READY
  BLOCKED
}

enum OpeningBalanceBatchStatus {
  DRAFT
  VALIDATED
  POSTED
  REVERSED
}

// -------------------------
// COMMON FIELD PATTERN NOTES
// -------------------------
// Soft delete:
// - We keep isDeleted + deletedAt.
// - Services must default-filter isDeleted=false for user-facing reads.
// - Hard deletes are avoided for auditability.
//
// Date/time:
// - createdAt/updatedAt are DateTime (timestamptz in Postgres).
// - Ledger uses entryDate (date) for reporting and dueDate (date) for aging.
// -------------------------

// ============================================================
// PLATFORM / AUTH
// ============================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  fullName     String?
  phone        String?
  status       UserStatus @default(ACTIVE)
  role         UserRole   @default(STAFF)

  // Tenant membership
  // - SUPER_ADMIN users may have companyId = null.
  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  // Simple, extendable permissions (for STAFF users)
  // - OWNER can be treated as "all true" in code (no row required),
  //   or you can still create a row for OWNER if you prefer consistency.
  permissions StaffPermission?

  // Security / sessions (refresh token rotation)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  // Notifications
  deviceTokens  DeviceToken[]  @relation("UserDeviceTokens")
  notifications Notification[] @relation("UserNotifications")

  // Audit relations (who created ledger entries, etc.)
  createdLedgerEntries LedgerEntry[] @relation("LedgerCreatedBy")
  auditLogs            AuditLog[]    @relation("AuditActor")

  // Phase 2: back-references for deferred sales & installments
  createdDeferredSales        DeferredSale[]        @relation("DeferredSaleCreatedBy")
  createdDeferredPayments     DeferredPayment[]     @relation("DeferredPaymentCreatedBy")
  createdInstallmentContracts InstallmentContract[] @relation("InstallmentContractCreatedBy")
  createdInstallmentPayments  InstallmentPayment[]  @relation("InstallmentPaymentCreatedBy")

  // Phase 3: back-reference for expenses
  createdExpenses Expense[] @relation("ExpenseCreatedBy")

  // Phase 4: back-reference for products catalog
  createdProducts Product[] @relation("ProductCreatedBy")

  // Phase K: back-reference for invoices
  createdInvoices Invoice[] @relation("InvoiceCreatedBy")

  // B01: authoritative accounting postings
  postedAccountingEntries      JournalEntry[]        @relation("AccountingEntryPostedBy")
  createdOpeningBalanceBatches OpeningBalanceBatch[] @relation("OpeningBalanceBatchCreatedBy")
  postedOpeningBalanceBatches  OpeningBalanceBatch[] @relation("OpeningBalanceBatchPostedBy")

  // P2-BE-1: back-reference for customer product prices
  updatedCustomerProductPrices CustomerProductPrice[] @relation("CustomerProductPriceUpdatedBy")

  // Optimistic locking
  version Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([companyId, status])
  @@index([role])
  @@index([companyId, isDeleted]) // list company users fast
}

// ============================================================
// PASSWORD RESET TOKENS
// ============================================================
// Flow: user requests reset → OTP generated → hashed OTP stored here
//       → OTP sent via email (Gmail) or WhatsApp (Twilio)
//       → user submits OTP + new password → token marked used + password updated
//
// Security:
//   - Only the SHA-256 hash of the OTP is stored (never raw OTP)
//   - Token is single-use (usedAt is set on consumption)
//   - Expires after 15 minutes
//   - All previous reset tokens for a user are deleted on new request
// ============================================================

model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 hash of the 6-digit OTP
  tokenHash String

  // Channel used to deliver the OTP
  channel String // 'email' | 'whatsapp'

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Store a HASH of the refresh token (never store the raw token).
  // Hash must be unique so stolen/duplicated tokens can be detected & revoked deterministically.
  tokenHash String @unique

  // Optional metadata (useful for "logout this device" and fraud detection)
  deviceId  String?
  userAgent String?
  ip        String?

  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

// ============================================================
// TENANT (COMPANY) + BILLING
// ============================================================

model Company {
  id                      String                 @id @default(uuid()) @db.Uuid
  name                    String
  phone                   String?
  address                 String?
  currencyCode            String                 @default("EGP")
  currency                Currency               @relation("CompanyCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  cashReconciliationMode  CashReconciliationMode @default(DISABLED)
  cashModeUpdatedByUserId String?                @db.Uuid
  cashModeUpdatedAt       DateTime?

  // Emergency kill-switch by Super Admin (doesn't replace subscription logic)
  isActive Boolean @default(true)

  // Optimistic locking
  version Int @default(0)

  users               User[]
  customers           Customer[]
  suppliers           Supplier[]
  businessPartners    BusinessPartner[]
  customerProfiles    CustomerProfile[]
  supplierProfiles    SupplierProfile[]
  partnerAddresses    BusinessPartnerAddress[]
  partnerContacts     BusinessPartnerContact[]
  paymentTerms        PaymentTerm[]
  employees           Employee[]
  ledgerEntries       LedgerEntry[]
  balances            Balance[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  cashReconciliations CashReconciliationDaily[]

  subscriptions CompanySubscription[]
  payments      SubscriptionPayment[]

  // Phase 2
  deferredSales        DeferredSale[]
  installmentContracts InstallmentContract[]

  // Phase 3
  expenses Expense[]

  // Phase 4
  products Product[]

  // Phase K
  invoices Invoice[]

  // P2-BE-1
  customerProductPrices CustomerProductPrice[]

  // Tax setup foundation
  taxRegistrationProfile TaxRegistrationProfile?
  taxRates               TaxRate[]
  taxTreatments          TaxTreatment[]
  taxDefaultPolicy       TaxDefaultPolicy?
  taxAccountBinding      TaxAccountBinding?
  taxApplicabilityRules  TaxModuleApplicabilityRule[]

  // B01: authoritative accounting core
  accountingConfiguration  AccountingConfiguration?
  accountingSetup          AccountingSetup?
  accountingAccounts       AccountingAccount[]
  accountingJournals       AccountingJournal[]
  fiscalYears              FiscalYear[]
  accountingPeriods        AccountingPeriod[]
  accountingEntrySequences AccountingEntrySequence[]
  accountingJournalEntries JournalEntry[]
  accountingJournalLines   JournalLine[]
  openingBalanceBatches    OpeningBalanceBatch[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([isActive, isDeleted])
  @@index([name])
}

model Plan {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @unique
  price        Decimal      @default(0.00) @db.Decimal(14, 2)
  currencyCode String       @default("EGP")
  billingCycle BillingCycle

  // Limits: null means unlimited
  maxUsers         Int?
  maxCustomers     Int?
  maxSuppliers     Int?
  maxEmployees     Int?
  maxLedgerEntries BigInt?

  // Flexible feature flags (future-proof)
  features      Json                  @default("[]")
  isActive      Boolean               @default(true)
  subscriptions CompanySubscription[]

  createdAt DateTime @default(now())

  @@index([isActive])
}

model CompanySubscription {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  planId String @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id])

  status        SubscriptionStatus @default(TRIAL)
  startDate     DateTime           @default(now())
  endDate       DateTime
  autoRenew     Boolean            @default(false)
  paymentStatus PaymentStatus      @default(PENDING)

  payments  SubscriptionPayment[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  // IMPORTANT: This is queried frequently; keep index tight.
  // NOTE: A partial unique index is enforced via SQL migration:
  //   CompanySubscription_one_live_per_company_idx
  // It guarantees at most one live subscription (TRIAL/ACTIVE/SUSPENDED)
  // per company. Prisma schema cannot currently express partial unique indexes.
  @@index([companyId, status, endDate])
  @@index([companyId, endDate])
  @@index([planId])
}

model CashReconciliationDaily {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  businessDate DateTime                 @db.Date
  status       CashReconciliationStatus @default(DRAFT)

  openingCash               Decimal @default(0.00) @db.Decimal(14, 2)
  cashSalesOutsideSystem    Decimal @default(0.00) @db.Decimal(14, 2)
  cashExpensesOutsideSystem Decimal @default(0.00) @db.Decimal(14, 2)
  actualCashCounted         Decimal @default(0.00) @db.Decimal(14, 2)
  expectedCash              Decimal @default(0.00) @db.Decimal(14, 2)
  variance                  Decimal @default(0.00) @db.Decimal(14, 2)

  note String?

  createdByUserId String? @db.Uuid
  updatedByUserId String? @db.Uuid
  closedByUserId  String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@unique([companyId, businessDate])
  @@index([companyId, status, businessDate])
  @@index([companyId, createdAt])
}

model SubscriptionPayment {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  subscriptionId String              @db.Uuid
  subscription   CompanySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(14, 2)
  currencyCode  String        @default("EGP")
  paymentMethod String?
  paymentRef    String?
  paymentDate   DateTime?
  status        PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([companyId, status, createdAt])
  @@index([subscriptionId])
}

// ============================================================
// TAX SETUP FOUNDATION
// ============================================================

model TaxRegistrationProfile {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @unique @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  countryCode               String
  regimeCode                String?
  vatRegistrationStatus     TaxRegistrationStatus   @default(NOT_REGISTERED)
  vatRegistrationNumber     String?
  legalTaxName              String?
  registrationEffectiveDate DateTime?
  taxAddressLine1           String?
  taxAddressLine2           String?
  city                      String?
  region                    String?
  postalCode                String?
  readinessStatus           TaxSetupReadinessStatus @default(NOT_CONFIGURED)
  notes                     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, vatRegistrationStatus])
  @@index([companyId, readinessStatus])
}

model TaxTreatment {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code            String
  normalizedCode  String
  name            String
  category        TaxTreatmentCategory
  calculationMode TaxCalculationMode
  description     String?
  isDefault       Boolean              @default(false)
  status          TaxLifecycleStatus   @default(ACTIVE)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?

  rates           TaxRate[]
  defaultPolicies TaxDefaultPolicy[]           @relation("DefaultPolicyTreatment")
  moduleRules     TaxModuleApplicabilityRule[] @relation("ApplicabilityTreatment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, normalizedCode])
  @@index([companyId, status])
  @@index([companyId, category])
}

model TaxRate {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  treatmentId String?       @db.Uuid
  treatment   TaxTreatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)

  code           String
  normalizedCode String
  name           String
  percentage     Decimal            @db.Decimal(9, 4)
  status         TaxLifecycleStatus @default(ACTIVE)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  description    String?
  isDefault      Boolean            @default(false)

  defaultPolicies TaxDefaultPolicy[]           @relation("DefaultPolicyRate")
  moduleRules     TaxModuleApplicabilityRule[] @relation("ApplicabilityRate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, normalizedCode])
  @@index([companyId, status])
  @@index([companyId, treatmentId])
  @@index([companyId, percentage])
}

model TaxDefaultPolicy {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @unique @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  defaultCalculationMode TaxCalculationMode @default(TAX_EXCLUSIVE)

  defaultRateId String?  @db.Uuid
  defaultRate   TaxRate? @relation("DefaultPolicyRate", fields: [defaultRateId], references: [id], onDelete: SetNull)

  defaultTreatmentId String?       @db.Uuid
  defaultTreatment   TaxTreatment? @relation("DefaultPolicyTreatment", fields: [defaultTreatmentId], references: [id], onDelete: SetNull)

  allowManualOverride Boolean @default(true)
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, defaultCalculationMode])
}

model TaxAccountBinding {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @unique @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  taxPayableAccountCode     String?
  recoverableTaxAccountCode String?
  outputTaxAccountCode      String?
  inputTaxAccountCode       String?
  roundingAccountCode       String?
  notes                     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model TaxModuleApplicabilityRule {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  moduleKey     TaxModuleKey
  isEnabled     Boolean      @default(true)
  allowOverride Boolean      @default(true)

  defaultRateId String?  @db.Uuid
  defaultRate   TaxRate? @relation("ApplicabilityRate", fields: [defaultRateId], references: [id], onDelete: SetNull)

  defaultTreatmentId String?       @db.Uuid
  defaultTreatment   TaxTreatment? @relation("ApplicabilityTreatment", fields: [defaultTreatmentId], references: [id], onDelete: SetNull)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, moduleKey])
  @@index([companyId, isEnabled])
}

// ============================================================
// RBAC (SIMPLE NOW, EXTENDABLE)
// ============================================================
// Simple approach for MVP:
// - User.role: OWNER/STAFF within company
// - StaffPermission: boolean flags for grouped capabilities
// - Later: introduce Role + Permission tables for fine-grained keys.
// ============================================================

model StaffPermission {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // JSON map of permission flags.
  // Shape: { manageUsers: bool, viewParties: bool, manageParties: bool, ... }
  // Adding a new permission = no migration needed, just update the app code.
  // Default is empty object → all permissions false by application logic.
  permissions Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// LEGACY PARTIES (CUSTOMERS / SUPPLIERS / EMPLOYEES)
// ============================================================
// These models remain only for unreplaced legacy modules. They are not the
// authoritative B02 external-party identity and their openingBalance fields
// are not read by BusinessPartner, the B01 GL, or any new B02 feature.
// ============================================================

model Customer {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name           String
  phone          String?
  address        String?
  openingBalance Decimal  @default(0.00) @db.Decimal(14, 2)
  creditLimit    Decimal? @db.Decimal(14, 2)
  isActive       Boolean  @default(true)

  // Optimistic locking — prevents concurrent update conflicts
  // Client must send the version it read; if changed by another user → 409 Conflict
  version Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  customerProductPrices CustomerProductPrice[] @relation("CustomerProductPrices")

  @@index([companyId, isDeleted, isActive])
  @@index([companyId, name])
}

model Supplier {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name           String
  phone          String?
  address        String?
  openingBalance Decimal @default(0.00) @db.Decimal(14, 2)
  isActive       Boolean @default(true)

  // Optimistic locking
  version Int @default(0)

  // Phase 3: expenses linked to this supplier (optional)
  expenses Expense[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([companyId, isDeleted, isActive])
  @@index([companyId, name])
}

// ============================================================
// B02: AUTHORITATIVE BUSINESS PARTNER DOMAIN
// ============================================================

model BusinessPartner {
  id                           String              @id @default(uuid()) @db.Uuid
  companyId                    String              @db.Uuid
  company                      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partnerCode                  String              @db.VarChar(40)
  partnerType                  BusinessPartnerType
  displayName                  String              @db.VarChar(200)
  legalName                    String?             @db.VarChar(200)
