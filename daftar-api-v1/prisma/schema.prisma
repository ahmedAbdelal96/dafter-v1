  status                        SalesCreditNoteStatus @default(DRAFT)
  creditNoteNumber              String?               @db.VarChar(40)
  documentDate                  DateTime              @db.Date
  postingDate                   DateTime?             @db.Date
  transactionCurrencyCode       String                @db.Char(3)
  transactionCurrency           Currency              @relation("SalesCreditNoteTransactionCurrency", fields: [transactionCurrencyCode], references: [code], onDelete: Restrict)
  exchangeRate                  Decimal               @db.Decimal(19, 8)
  reason                        String                @db.VarChar(1000)
  subtotal                      Decimal               @db.Decimal(19, 4)
  taxTotal                      Decimal               @db.Decimal(19, 4)
  grandTotal                    Decimal               @db.Decimal(19, 4)
  partnerCodeSnapshot           String                @db.VarChar(40)
  partnerNameSnapshot           String                @db.VarChar(200)
  taxRegistrationNumberSnapshot String?
  billingAddressSnapshot        Json?
  postedById                    String?               @db.Uuid
  postedBy                      User?                 @relation("SalesCreditNotePostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  postedAt                      DateTime?
  journalEntryId                String?               @db.Uuid
  journalEntry                  JournalEntry?         @relation("SalesCreditNoteJournalEntry", fields: [journalEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  receivableAccountId           String?               @db.Uuid
  receivableAccount             AccountingAccount?    @relation("SalesCreditNoteReceivableAccount", fields: [receivableAccountId, companyId], references: [id, companyId], onDelete: Restrict)
  idempotencyKey                String?               @db.VarChar(128)
  requestHash                   String?               @db.Char(64)
