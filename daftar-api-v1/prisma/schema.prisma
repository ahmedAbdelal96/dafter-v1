// ============================================================
// Hesabatak (حساباتك) — Production-ready Prisma Schema
// Stack: NestJS + PostgreSQL + Prisma
//
// Design goals:
// - Multi-tenant (single DB): every tenant-owned row has companyId
// - Strong performance: thoughtful indexes for common queries
// - Maintainability: clear enums, consistent naming, soft-delete fields
// - Scalable RBAC: simple roles now, expandable to fine-grained permissions
// - Ledger engine: unified ledger_entries + balances for fast reads
// - SaaS billing: plans + subscriptions + payments (managed by Super Admin)
//
// Notes (IMPORTANT):
// - Prisma cannot enforce Row Level Security (RLS). Tenant isolation MUST be enforced
//   in NestJS services/guards by always scoping queries to companyId.
// - Ledger write operations MUST run inside prisma.$transaction() to keep
//   ledger_entries + balances + audit_logs consistent.
// - Opening balances strategy (DECIDED):
//   * openingBalance is stored on party (Customer/Supplier/Employee).
//   * Balance.balance stores the CURRENT balance.
//   * On party creation, the service MUST initialize Balance.balance = openingBalance (transaction).
//   * Afterwards, every ledger entry updates Balance.balance incrementally.
//   * Optional repair endpoint can recompute from openingBalance + SUM(ledger signedAmount).
//
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------
// ENUMS
// -------------------------

enum UserRole {
  // Company-level roles
  OWNER
  STAFF

  // Platform-level role
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  EMPLOYEE
}

enum BusinessPartnerType {
  ORGANIZATION
  PERSON
}

enum BusinessPartnerAddressType {
  BILLING
  SHIPPING
  REGISTERED
  OTHER
}

enum LedgerEntryType {
  // Generic
  INVOICE
  PAYMENT
  RETURN
  ADJUSTMENT

  // Employee-focused (optional in MVP)
  ADVANCE
  SALARY_PAYMENT
  DEDUCTION
  SETTLEMENT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
  DISABLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum CashReconciliationMode {
  DISABLED
  SIMPLE_DAILY
}

enum CashReconciliationStatus {
  DRAFT
  CLOSED
}

enum TaxRegistrationStatus {
  NOT_REGISTERED
  PENDING
  REGISTERED
  SUSPENDED
}

enum TaxSetupReadinessStatus {
  NOT_CONFIGURED
  PARTIALLY_CONFIGURED
  READY
}

enum TaxLifecycleStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TaxTreatmentCategory {
  STANDARD
  ZERO_RATED
  EXEMPT
  OUT_OF_SCOPE
  CUSTOM
}

enum TaxCalculationMode {
  TAX_EXCLUSIVE
  TAX_INCLUSIVE
}

enum TaxModuleKey {
  SALES
  PURCHASES
  EXPENSES
  JOURNALS
}

// ── Phase 3: Expenses Enum ─────────────────────────────────────────────────

// Classifies what the money was spent on — drives category filtering & pie charts.
enum ExpenseCategory {
  RENT // إيجار
  SALARIES // رواتب
  UTILITIES // مرافق (كهرباء / مياه / إنترنت)
  SUPPLIES // مستلزمات / بضاعة
  TRANSPORTATION // مواصلات / شحن
  MAINTENANCE // صيانة
  MARKETING // تسويق وإعلان
  TAXES // ضرائب ورسوم
  OTHER // أخرى
}

// ── Phase 2: Sale & Installment Enums ─────────────────────────────────────

// Categorises a LedgerEntry so the frontend can distinguish
// immediate cash sales from deferred (آجل) and installment (أقساط) sales.
enum SaleType {
  CASH
  DEFERRED // بيع آجل — single future due date, supports partial payments
  INSTALLMENT // بيع بالتقسيط — structured schedule of multiple payments
}

// Lifecycle of a single deferred (آجل) sale.
// Transitions: PENDING → PARTIAL (first partial pay) → PAID (fully settled)
//                      → OVERDUE (daily job flips after dueDate passes)
enum DeferredSaleStatus {
  PENDING // لم يُدفع بعد
  PARTIAL // دُفع جزء منه
  PAID // مسدد بالكامل
  OVERDUE // متأخر — dueDate مرّ ولم يُسدَّد
}

// Lifecycle of an installment contract.
enum InstallmentStatus {
  ACTIVE // جاري — still has pending/partial schedules
  COMPLETED // مكتمل — all schedules paid
  CANCELLED // ملغي — cancelled before completion
  DEFAULTED // متوقف عن السداد — admin/manual override
}

// Lifecycle of a single instalment row in the schedule.
enum ScheduleStatus {
  PENDING // لم يحل موعده أو حلّ ولم يُدفع
  PARTIAL // دُفع جزء منه
  PAID // مسدد
  OVERDUE // متأخر — daily job flips after dueDate passes
  WAIVED // أُعفي منه
}

// How the instalment schedule was built.
enum ScheduleType {
  FIXED // جميع الأقساط بنفس المبلغ — generated automatically
  CUSTOM // التاجر يدخل كل قسط يدوياً — irregular amounts or intervals
}

// ============================================================
// B01: AUTHORITATIVE ACCOUNTING CORE
// ============================================================

enum AccountingAccountType {
  ASSET_RECEIVABLE
  ASSET_CASH
  ASSET_BANK
  ASSET_CURRENT
  ASSET_INVENTORY
  ASSET_PREPAID
  ASSET_FIXED
  ASSET_OTHER
  LIABILITY_PAYABLE
  LIABILITY_CURRENT
  LIABILITY_NON_CURRENT
  LIABILITY_TAX
  EQUITY
  INCOME_OPERATING_REVENUE
  INCOME_OTHER
  EXPENSE_COGS
  EXPENSE_OPERATING
  EXPENSE_DEPRECIATION
  EXPENSE_OTHER
}

