  customerPayment          CustomerPayment?           @relation(fields: [customerPaymentId, companyId], references: [id, companyId], onDelete: Restrict)
  transactionAmount        Decimal                    @db.Decimal(19, 4)
  debitBaseAmountApplied   Decimal                    @db.Decimal(19, 4)
  creditBaseAmountApplied  Decimal                    @db.Decimal(19, 4)
  realizedFxAmount         Decimal                    @db.Decimal(19, 4)
  status                   ARReconciliationStatus     @default(ACTIVE)
  adjustmentJournalEntryId String?                    @db.Uuid
  adjustmentJournalEntry   JournalEntry?              @relation("ARReconciliationAdjustmentJournalEntry", fields: [adjustmentJournalEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  reversalJournalEntryId   String?                    @db.Uuid
  reversalJournalEntry     JournalEntry?              @relation("ARReconciliationReversalJournalEntry", fields: [reversalJournalEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  idempotencyKey           String                     @db.VarChar(128)
  requestHash              String                     @db.Char(64)
  createdById              String                     @db.Uuid
  createdBy                User                       @relation("ARReconciliationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reversedById             String?                    @db.Uuid
  reversedBy               User?                      @relation("ARReconciliationReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reversedAt               DateTime?
  reversalReason           String?                    @db.VarChar(500)
  reversalIdempotencyKey   String?                    @db.VarChar(128)
  reversalRequestHash      String?                    @db.Char(64)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
