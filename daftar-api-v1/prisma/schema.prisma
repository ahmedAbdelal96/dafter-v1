model AccountingTemplate {
  id                  String    @id @default(uuid()) @db.Uuid
  code                String    @db.VarChar(40)
  version             Int
  countryCode         String    @db.Char(2)
  name                String    @db.VarChar(160)
  description         String?   @db.VarChar(1000)
  defaultCurrencyCode String?   @db.Char(3)
  defaultCurrency     Currency? @relation("AccountingTemplateDefaultCurrency", fields: [defaultCurrencyCode], references: [code], onDelete: Restrict)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts AccountingTemplateAccount[]
  setups   AccountingSetup[]

  @@unique([code, version])
  @@index([countryCode, isActive])
}

model AccountingTemplateAccount {
  id                     String                      @id @default(uuid()) @db.Uuid
  templateId             String                      @db.Uuid
  template               AccountingTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stableKey              String                      @db.VarChar(80)
  code                   String                      @db.VarChar(40)
  arabicName             String                      @db.VarChar(200)
  englishName            String                      @db.VarChar(200)
  accountType            AccountingAccountType
  parentId               String?                     @db.Uuid
  parent                 AccountingTemplateAccount?  @relation("AccountingTemplateHierarchy", fields: [parentId, templateId], references: [id, templateId], onDelete: Restrict)
  children               AccountingTemplateAccount[] @relation("AccountingTemplateHierarchy")
  allowDirectPosting     Boolean                     @default(true)
  isControlAccount       Boolean                     @default(false)
  reconciliationEligible Boolean                     @default(false)
  systemKey              String?                     @db.VarChar(80)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@unique([id, templateId])
  @@unique([templateId, stableKey])
  @@index([templateId, parentId])
  @@index([templateId, systemKey])
}

model AccountingAccount {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerPaymentDestinations CustomerPayment[] @relation("CustomerPaymentDestinationAccount")
  customerPaymentReceivables  CustomerPayment[] @relation("CustomerPaymentReceivableAccount")
  supplierPaymentSources      SupplierPayment[] @relation("SupplierPaymentSourceAccount")
  supplierPaymentPayables     SupplierPayment[] @relation("SupplierPaymentPayableAccount")

  code                   String                @db.VarChar(40)
  name                   String                @db.VarChar(200)
  accountType            AccountingAccountType
  currencyCode           String?               @db.Char(3)
  currency               Currency?             @relation("AccountingAccountCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  parentId               String?               @db.Uuid
  parent                 AccountingAccount?    @relation("AccountingAccountHierarchy", fields: [parentId, companyId], references: [id, companyId], onDelete: Restrict)
  children               AccountingAccount[]   @relation("AccountingAccountHierarchy")
  isActive               Boolean               @default(true)
  allowDirectPosting     Boolean               @default(true)
  isControlAccount       Boolean               @default(false)
  reconciliationEligible Boolean               @default(false)
  templateCode           String?               @db.VarChar(40)
  templateVersion        Int?
  templateKey            String?               @db.VarChar(80)
  archivedAt             DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  journalLines                      JournalLine[]
  openingBalanceLines               OpeningBalanceLine[]
  configurationDefaults             AccountingConfigurationAccount[]
  customerReceivableOverrides       CustomerProfile[]                @relation("CustomerReceivableOverride")
  supplierPayableOverrides          SupplierProfile[]                @relation("SupplierPayableOverride")
  salesInvoiceReceivables           SalesInvoice[]                   @relation("SalesInvoiceReceivableAccount")
  salesInvoiceLineRevenues          SalesInvoiceLine[]               @relation("SalesInvoiceLineRevenueAccount")
  salesInvoiceLineTaxLiabilities    SalesInvoiceLineTax[]            @relation("SalesInvoiceLineTaxLiabilityAccount")
  salesCreditNoteReceivables        SalesCreditNote[]                @relation("SalesCreditNoteReceivableAccount")
  salesCreditNoteLineRevenues       SalesCreditNoteLine[]            @relation("SalesCreditNoteLineRevenueAccount")
  salesCreditNoteLineTaxLiabilities SalesCreditNoteLine[]            @relation("SalesCreditNoteLineTaxLiabilityAccount")
  purchaseOrderExpenseLines         PurchaseOrderLine[]              @relation("PurchaseOrderExpenseAccount")
  purchaseOrderAssetLines           PurchaseOrderLine[]              @relation("PurchaseOrderAssetAccount")

  supplierInvoicePayables         SupplierInvoice[]           @relation("SupplierInvoicePayableAccount")
  supplierInvoiceExpenseLines     SupplierInvoiceLine[]       @relation("SupplierInvoiceLineExpenseAccount")
  supplierInvoiceAssetLines       SupplierInvoiceLine[]       @relation("SupplierInvoiceLineAssetAccount")
  supplierInvoiceTaxInputLines    SupplierInvoiceLineTax[]    @relation("SupplierInvoiceLineTaxInputAccount")
  supplierCreditNotePayables      SupplierCreditNote[]        @relation("SupplierCreditNotePayableAccount")
  supplierCreditNoteExpenseLines  SupplierCreditNoteLine[]    @relation("SupplierCreditNoteLineExpenseAccount")
  supplierCreditNoteAssetLines    SupplierCreditNoteLine[]    @relation("SupplierCreditNoteLineAssetAccount")
  supplierCreditNoteTaxInputLines SupplierCreditNoteLineTax[] @relation("SupplierCreditNoteLineTaxInputAccount")

  @@unique([id, companyId])
  @@unique([companyId, code])
  @@unique([companyId, templateKey])
  @@index([companyId, parentId])
  @@index([companyId, accountType, isActive])
}

model AccountingJournal {
  id           String                @id @default(uuid()) @db.Uuid
  companyId    String                @db.Uuid
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String                @db.VarChar(40)
  name         String                @db.VarChar(200)
  type         AccountingJournalType
  currencyCode String?               @db.Char(3)
  currency     Currency?             @relation("AccountingJournalCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  entries               JournalEntry[]
  configurationDefaults AccountingConfigurationJournal[]

  @@unique([id, companyId])
  @@unique([companyId, code])
  @@index([companyId, type, isActive])
}

model FiscalYear {
  id        String           @id @default(uuid()) @db.Uuid
  companyId String           @db.Uuid
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String           @db.VarChar(40)
  startDate DateTime         @db.Date
  endDate   DateTime         @db.Date
  status    FiscalYearStatus @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  periods                   AccountingPeriod[]
  sequences                 AccountingEntrySequence[]
  salesDocumentSequences    SalesDocumentSequence[]
  customerPaymentSequences  CustomerPaymentSequence[]
  supplierPaymentSequences  SupplierPaymentSequence[]
  supplierDocumentSequences SupplierDocumentSequence[]

  @@unique([id, companyId])
  @@unique([companyId, name])
  @@index([companyId, startDate, endDate])
}

model AccountingPeriod {
  id           String                 @id @default(uuid()) @db.Uuid
  companyId    String                 @db.Uuid
  company      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId String                 @db.Uuid
  fiscalYear   FiscalYear             @relation(fields: [fiscalYearId, companyId], references: [id, companyId], onDelete: Restrict)
  name         String                 @db.VarChar(80)
  startDate    DateTime               @db.Date
  endDate      DateTime               @db.Date
  status       AccountingPeriodStatus @default(OPEN)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  journalEntries        JournalEntry[]
  openingBalanceBatches OpeningBalanceBatch[]

  @@unique([id, companyId])
  @@unique([companyId, fiscalYearId, name])
  @@index([companyId, startDate, endDate, status])
}

model AccountingEntrySequence {
  companyId    String     @db.Uuid
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId String     @db.Uuid
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId, companyId], references: [id, companyId], onDelete: Cascade)
  nextValue    Int        @default(1)
  updatedAt    DateTime   @updatedAt

  @@id([companyId, fiscalYearId])
}

model JournalEntry {
  id                 String            @id @default(uuid()) @db.Uuid
  companyId          String            @db.Uuid
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalId          String            @db.Uuid
  journal            AccountingJournal @relation(fields: [journalId, companyId], references: [id, companyId], onDelete: Restrict)
  accountingPeriodId String            @db.Uuid
  accountingPeriod   AccountingPeriod  @relation(fields: [accountingPeriodId, companyId], references: [id, companyId], onDelete: Restrict)

  entryNumber                 String               @db.VarChar(40)
  status                      JournalEntryStatus   @default(DRAFT)
  postingDate                 DateTime             @db.Date
  documentDate                DateTime?            @db.Date
  dueDate                     DateTime?            @db.Date
  transactionCurrencyCode     String               @db.Char(3)
  transactionCurrency         Currency             @relation("JournalEntryTransactionCurrency", fields: [transactionCurrencyCode], references: [code], onDelete: Restrict)
  exchangeRate                Decimal              @db.Decimal(19, 8)
  documentReference           String?              @db.VarChar(120)
  description                 String               @db.VarChar(500)
  sourceType                  JournalSourceType
  sourceId                    String?              @db.Uuid
  idempotencyKey              String               @db.VarChar(128)
  requestHash                 String               @db.Char(64)
  postedById                  String?              @db.Uuid
  postedBy                    User?                @relation("AccountingEntryPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  postedAt                    DateTime?
  reversalOfEntryId           String?              @db.Uuid
  reversalOf                  JournalEntry?        @relation("JournalEntryReversal", fields: [reversalOfEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  reversals                   JournalEntry[]       @relation("JournalEntryReversal")
  openingBalanceBatch         OpeningBalanceBatch? @relation("OpeningBalanceBatchJournalEntry")
  openingBalanceReversalBatch OpeningBalanceBatch? @relation("OpeningBalanceBatchReversalJournalEntry")
  reversalReason              String?              @db.VarChar(500)
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  lines                       JournalLine[]
  salesInvoice                SalesInvoice?       @relation("SalesInvoiceJournalEntry")
  salesCreditNote             SalesCreditNote?    @relation("SalesCreditNoteJournalEntry")
  customerPayment             CustomerPayment?    @relation("CustomerPaymentJournalEntry")
  customerPaymentReversal     CustomerPayment?    @relation("CustomerPaymentReversalJournalEntry")
  arReconciliationAdjustments ARReconciliation[]  @relation("ARReconciliationAdjustmentJournalEntry")
  arReconciliationReversals   ARReconciliation[]  @relation("ARReconciliationReversalJournalEntry")
  supplierPayment             SupplierPayment?   @relation("SupplierPaymentJournalEntry")
  supplierPaymentReversal     SupplierPayment?   @relation("SupplierPaymentReversalJournalEntry")
  apReconciliationAdjustments APReconciliation[] @relation("APReconciliationAdjustmentJournalEntry")
  apReconciliationReversals   APReconciliation[] @relation("APReconciliationReversalJournalEntry")
  supplierInvoice             SupplierInvoice?    @relation("SupplierInvoiceJournalEntry")
  supplierCreditNote          SupplierCreditNote? @relation("SupplierCreditNoteJournalEntry")

  @@unique([id, companyId])
  @@unique([companyId, entryNumber])
  @@unique([companyId, sourceType, idempotencyKey])
  @@unique([companyId, reversalOfEntryId])
  @@index([companyId, postingDate])
  @@index([companyId, journalId, postingDate])
  @@index([companyId, sourceType, sourceId])
  @@index([companyId, status])
  @@index([companyId, accountingPeriodId])
}

model OpeningBalanceBatch {
  id                     String                    @id @default(uuid()) @db.Uuid
  companyId              String                    @db.Uuid
  company                Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  effectiveDate          DateTime                  @db.Date
