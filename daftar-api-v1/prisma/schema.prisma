  status                 OpeningBalanceBatchStatus @default(DRAFT)
  description            String                    @db.VarChar(500)
  createdById            String                    @db.Uuid
  createdBy              User                      @relation("OpeningBalanceBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedById             String?                   @db.Uuid
  postedBy               User?                     @relation("OpeningBalanceBatchPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  journalEntryId         String?                   @db.Uuid
  journalEntry           JournalEntry?             @relation("OpeningBalanceBatchJournalEntry", fields: [journalEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  reversalJournalEntryId String?                   @db.Uuid
  reversalJournalEntry   JournalEntry?             @relation("OpeningBalanceBatchReversalJournalEntry", fields: [reversalJournalEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  idempotencyKey         String                    @db.VarChar(128)
  requestHash            String                    @db.Char(64)
  postingIdempotencyKey  String?                   @db.VarChar(128)
  postingRequestHash     String?                   @db.Char(64)
  reversalIdempotencyKey String?                   @db.VarChar(128)
  reversalRequestHash    String?                   @db.Char(64)
  validatedAt            DateTime?
  postedAt               DateTime?
  reversedAt             DateTime?
  reversalReason         String?                   @db.VarChar(500)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  lines OpeningBalanceLine[]

  @@unique([id, companyId])
  @@unique([companyId, idempotencyKey])
  @@unique([companyId, journalEntryId])
  @@unique([journalEntryId, companyId])
  @@unique([companyId, postingIdempotencyKey])
  @@unique([companyId, reversalIdempotencyKey])
  @@unique([companyId, reversalJournalEntryId])
  @@unique([reversalJournalEntryId, companyId])
  @@index([companyId, status, effectiveDate])
}

model OpeningBalanceLine {
  id                String              @id @default(uuid()) @db.Uuid
  companyId         String              @db.Uuid
  batchId           String              @db.Uuid
  batch             OpeningBalanceBatch @relation(fields: [batchId, companyId], references: [id, companyId], onDelete: Cascade)
  accountId         String              @db.Uuid
  account           AccountingAccount   @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: Restrict)
  businessPartnerId String?             @db.Uuid
  businessPartner   BusinessPartner?    @relation(fields: [businessPartnerId, companyId], references: [id, companyId], onDelete: Restrict)
  debit             Decimal             @db.Decimal(19, 4)
  credit            Decimal             @db.Decimal(19, 4)
  description       String?             @db.VarChar(500)
  createdAt         DateTime            @default(now())

  @@unique([id, companyId])
  @@index([companyId, batchId])
  @@index([companyId, accountId])
  @@index([companyId, businessPartnerId])
}

model JournalLine {
  id                             String                          @id @default(uuid()) @db.Uuid
  companyId                      String                          @db.Uuid
  company                        Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntryId                 String                          @db.Uuid
  sequence                       Int
  journalEntry                   JournalEntry                    @relation(fields: [journalEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  accountId                      String                          @db.Uuid
  account                        AccountingAccount               @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: Restrict)
  debit                          Decimal                         @db.Decimal(19, 4)
  credit                         Decimal                         @db.Decimal(19, 4)
  transactionDebit               Decimal                         @db.Decimal(19, 4)
  transactionCredit              Decimal                         @db.Decimal(19, 4)
  description                    String?                         @db.VarChar(500)
  businessPartnerId              String?                         @db.Uuid
  businessPartner                BusinessPartner?                @relation(fields: [businessPartnerId, companyId], references: [id, companyId], onDelete: Restrict)
  dueDate                        DateTime?                       @db.Date
  documentReference              String?                         @db.VarChar(120)
  reconciliationReference        String?                         @db.VarChar(160)
  salesInvoicePaymentSchedule    SalesInvoicePaymentSchedule?    @relation("SalesInvoicePaymentScheduleJournalLine")
  customerPaymentAllocations     CustomerPaymentAllocation[]
  customerPaymentARSources       CustomerPayment[]               @relation("CustomerPaymentARSourceLine")
  arReconciliationDebits         ARReconciliation[]              @relation("ARReconciliationDebit")
  arReconciliationCredits        ARReconciliation[]              @relation("ARReconciliationCredit")
  supplierPaymentAllocations     SupplierPaymentAllocation[]
  supplierPaymentAPSources       SupplierPayment[]               @relation("SupplierPaymentAPSourceLine")
  apReconciliationDebits         APReconciliation[]              @relation("APReconciliationDebit")
  apReconciliationCredits        APReconciliation[]              @relation("APReconciliationCredit")
  supplierInvoicePaymentSchedule SupplierInvoicePaymentSchedule? @relation("SupplierInvoicePaymentScheduleJournalLine")
  taxCode                        String?                         @db.VarChar(40)
  taxTreatmentCode               String?                         @db.VarChar(40)
  taxRate                        Decimal?                        @db.Decimal(9, 4)
  createdAt                      DateTime                        @default(now())

  @@unique([id, companyId])
  @@unique([companyId, journalEntryId, sequence])
  @@index([companyId, accountId])
  @@index([companyId, journalEntryId])
  @@index([companyId, businessPartnerId])
  @@index([accountId, createdAt])
}

model AccountingConfiguration {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String    @unique @db.Uuid
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  baseCurrencyCode      String    @db.Char(3)
  baseCurrency          Currency  @relation("AccountingBaseCurrency", fields: [baseCurrencyCode], references: [code], onDelete: Restrict)
  reportingCurrencyCode String?   @db.Char(3)
  reportingCurrency     Currency? @relation("AccountingReportingCurrency", fields: [reportingCurrencyCode], references: [code], onDelete: Restrict)
  countryCode           String    @db.Char(2)
  localeCode            String    @db.VarChar(20)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accountDefaults AccountingConfigurationAccount[]
  journalDefaults AccountingConfigurationJournal[]

  @@unique([id, companyId])
}

model AccountingSetup {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @unique @db.Uuid
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status          AccountingSetupStatus @default(NOT_CONFIGURED)
  templateCode    String                @db.VarChar(40)
  templateVersion Int
  template        AccountingTemplate    @relation(fields: [templateCode, templateVersion], references: [code, version], onDelete: Restrict)
  lastError       String?               @db.VarChar(2000)
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([id, companyId])
  @@index([status])
}

// B01.1: canonical currency reference data. The accounting engine validates
// transaction precision from minorUnitPrecision while keeping GL storage at
// four decimal places for deterministic conversion and reporting.
model Currency {
  code               String   @id @db.Char(3)
  name               String   @db.VarChar(100)
  nativeName         String?  @db.VarChar(100)
  symbol             String?  @db.VarChar(12)
  minorUnitPrecision Int
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  accountingAccounts      AccountingAccount[]       @relation("AccountingAccountCurrency")
  accountingJournals      AccountingJournal[]       @relation("AccountingJournalCurrency")
  journalEntries          JournalEntry[]            @relation("JournalEntryTransactionCurrency")
  salesInvoices           SalesInvoice[]            @relation("SalesInvoiceTransactionCurrency")
  salesCreditNotes        SalesCreditNote[]         @relation("SalesCreditNoteTransactionCurrency")
  customerPayments        CustomerPayment[]         @relation("CustomerPaymentTransactionCurrency")
  supplierPayments        SupplierPayment[]         @relation("SupplierPaymentTransactionCurrency")
  purchaseOrders          PurchaseOrder[]           @relation("PurchaseOrderTransactionCurrency")
  supplierInvoices        SupplierInvoice[]         @relation("SupplierInvoiceTransactionCurrency")
  supplierCreditNotes     SupplierCreditNote[]      @relation("SupplierCreditNoteTransactionCurrency")
  baseConfigurations      AccountingConfiguration[] @relation("AccountingBaseCurrency")
  reportingConfigurations AccountingConfiguration[] @relation("AccountingReportingCurrency")
  templateDefaults        AccountingTemplate[]      @relation("AccountingTemplateDefaultCurrency")
  customerPreferences     CustomerProfile[]         @relation("CustomerPreferredCurrency")
  supplierPreferences     SupplierProfile[]         @relation("SupplierPreferredCurrency")
  companies               Company[]                 @relation("CompanyCurrency")

  @@index([isActive])
}

model AccountingConfigurationAccount {
  id              String                     @id @default(uuid()) @db.Uuid
  companyId       String                     @db.Uuid
  configurationId String                     @db.Uuid
  configuration   AccountingConfiguration    @relation(fields: [configurationId, companyId], references: [id, companyId], onDelete: Cascade)
  settingKey      AccountingConfigAccountKey
  accountId       String                     @db.Uuid
  account         AccountingAccount          @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([id, companyId])
  @@unique([companyId, configurationId, settingKey])
  @@index([companyId, accountId])
}

model AccountingConfigurationJournal {
  id              String                     @id @default(uuid()) @db.Uuid
  companyId       String                     @db.Uuid
  configurationId String                     @db.Uuid
  configuration   AccountingConfiguration    @relation(fields: [configurationId, companyId], references: [id, companyId], onDelete: Cascade)
  settingKey      AccountingConfigJournalKey
  journalId       String                     @db.Uuid
  journal         AccountingJournal          @relation(fields: [journalId, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([id, companyId])
  @@unique([companyId, configurationId, settingKey])
  @@index([companyId, journalId])
}
