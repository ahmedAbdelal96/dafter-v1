// ============================================================
// PHASE 2: DEFERRED SALES (بيع الآجل)
// ============================================================
//
// Design decisions:
// - DeferredSale is the "header" that tracks aggregate state (paidAmount, status).
// - DeferredPayment is a lightweight link between a PAYMENT LedgerEntry and its
//   parent deferred sale — the actual financial record lives in LedgerEntry.
// - partyType is stored (not just customerId) so deferred sales can be issued
//   to Suppliers or Employees in the future without a schema migration.
// - referenceNumber is human-readable: DEF-{YYYY}-{NNNN}.
// - paidAmount is updated incrementally in the same transaction as the payment
//   LedgerEntry to keep them consistent. Never compute from children in queries.
// ============================================================

model DeferredSale {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Polymorphic party — same pattern as LedgerEntry
  partyType PartyType
  partyId   String    @db.Uuid

  // The INVOICE LedgerEntry that booked the full debt on party creation.
  // Unique ensures 1:1 — one deferred sale = one opening invoice.
  ledgerEntryId String @unique @db.Uuid

  // Human-readable reference: DEF-2024-0001
  referenceNumber String
  description     String? @db.VarChar(500)

  totalAmount Decimal @db.Decimal(14, 2)

  // Incremented atomically on each payment. Stored for O(1) read.
  // Rule: paidAmount <= totalAmount always.
  paidAmount Decimal @default(0.00) @db.Decimal(14, 2)

  dueDate DateTime           @db.Date
  status  DeferredSaleStatus @default(PENDING)

  createdById String @db.Uuid
  createdBy   User   @relation("DeferredSaleCreatedBy", fields: [createdById], references: [id])

  // Optimistic locking — concurrent payment recording prevention
  version Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  payments DeferredPayment[]

  // Phase K: an invoice can be generated from this sale (at most one)
  invoice Invoice?

  @@index([companyId, partyType, partyId, status])
  @@index([companyId, dueDate, status]) // daily overdue job + collection report
  @@index([companyId, referenceNumber]) // lookup by ref number
  @@index([companyId, createdAt(sort: Desc)]) // list with default sort
}

// Each row represents one payment instalment against a DeferredSale.
// The financial record is the referenced LedgerEntry (PAYMENT, saleType=DEFERRED).
model DeferredPayment {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  deferredSaleId String       @db.Uuid
  deferredSale   DeferredSale @relation(fields: [deferredSaleId], references: [id], onDelete: Cascade)

  // The PAYMENT LedgerEntry created alongside this record (atomic transaction).
  // Unique — one payment record per ledger entry.
  ledgerEntryId String @unique @db.Uuid

  amount        Decimal  @db.Decimal(14, 2)
  paymentDate   DateTime @db.Date
  paymentMethod String?  @db.VarChar(100) // نقد / تحويل بنكي / شيك / إلخ
  notes         String?  @db.VarChar(500)

  createdById String @db.Uuid
  createdBy   User   @relation("DeferredPaymentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, deferredSaleId])
  @@index([companyId, paymentDate])
}

// ============================================================
// PHASE 2: INSTALLMENT CONTRACTS (بيع بالتقسيط)
// ============================================================
//
// Design decisions:
// - InstallmentContract is the header; InstallmentSchedule holds individual
//   due rows; InstallmentPayment records each payment hit against a schedule row.
// - paidAmount on Contract is kept in sync (incremented atomically) for O(1) reads.
// - scheduleType=FIXED: server generates rows automatically (totalAmount/n per month).
//   scheduleType=CUSTOM: client sends rows manually (irregular amounts/dates).
// - downPayment is recorded as a separate PAYMENT LedgerEntry on contract creation.
// - contractNumber format: CNT-{YYYY}-{NNNN}.
// ============================================================

model InstallmentContract {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Polymorphic party — extensible to Supplier/Employee
  partyType PartyType
  partyId   String    @db.Uuid

  // The INVOICE LedgerEntry that booked the full debt (totalAmount - downPayment).
  ledgerEntryId String @unique @db.Uuid

  contractNumber String // CNT-2024-0001
  description    String? @db.VarChar(500)

  totalAmount Decimal @db.Decimal(14, 2) // إجمالي قيمة البيع
  downPayment Decimal @default(0.00) @db.Decimal(14, 2) // المقدم (paid upfront)

  // Incremented atomically on each payment. Includes downPayment.
  paidAmount Decimal @default(0.00) @db.Decimal(14, 2)

  numberOfInstallments Int
  scheduleType         ScheduleType
  startDate            DateTime     @db.Date // تاريخ أول قسط

  status InstallmentStatus @default(ACTIVE)

  createdById String @db.Uuid
  createdBy   User   @relation("InstallmentContractCreatedBy", fields: [createdById], references: [id])

  // Optimistic locking
  version Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  schedules InstallmentSchedule[]

  @@index([companyId, partyType, partyId, status])
  @@index([companyId, status])
  @@index([companyId, contractNumber]) // lookup by number
  @@index([companyId, createdAt(sort: Desc)])
}

// One row per instalment in the schedule.
// Tracks how much was paid against each individual due date.
model InstallmentSchedule {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  contractId String              @db.Uuid
  contract   InstallmentContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  installmentNumber Int // 1, 2, 3, … for ordering and display
  dueDate           DateTime @db.Date
  amount            Decimal  @db.Decimal(14, 2) // المبلغ المستحق لهذا القسط

  // Incremented atomically on each payment. Stored for O(1) reads.
  paidAmount Decimal @default(0.00) @db.Decimal(14, 2)

  status ScheduleStatus @default(PENDING)
  paidAt DateTime? // set when status reaches PAID
  notes  String?        @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments InstallmentPayment[]

  @@index([companyId, contractId, installmentNumber])
  @@index([companyId, dueDate, status]) // daily overdue job + upcoming schedule report
}

// Records a single payment hit against a schedule row.
// The financial record lives in the referenced PAYMENT LedgerEntry.
model InstallmentPayment {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  contractId String @db.Uuid
  scheduleId String @db.Uuid

  schedule InstallmentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // The PAYMENT LedgerEntry created in the same transaction.
  ledgerEntryId String @unique @db.Uuid

  amount        Decimal  @db.Decimal(14, 2)
  paymentDate   DateTime @db.Date
  paymentMethod String?  @db.VarChar(100)
  notes         String?  @db.VarChar(500)

  createdById String @db.Uuid
  createdBy   User   @relation("InstallmentPaymentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, contractId])
  @@index([companyId, scheduleId])
  @@index([companyId, paymentDate])
}

// ============================================================
// PUSH NOTIFICATIONS
// ============================================================

// Stores Expo push tokens per user per device.
// One user can have many devices (phone + tablet, iOS + Android).
// Tokens are deactivated on logout rather than deleted (preserves history).
model DeviceToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation("UserDeviceTokens", fields: [userId], references: [id], onDelete: Cascade)

  // Expo push token format: "ExponentPushToken[xxxx]"
  // Unique constraint prevents duplicate registrations for same device.
  token String @unique

  // Client platform — used for analytics and future platform-specific delivery
  platform String // 'ios' | 'android' | 'web'

  // Human-readable device name sent from the app (e.g. "iPhone 15 Pro")
  deviceName String?

  // false after explicit logout/unregister — kept for audit trail
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive]) // fast: get all active tokens for a user
  @@index([token]) // fast: look up token for deduplication
}

// In-app notification records.
// Every push notification has a corresponding DB record for:
//   1. In-app notification feed (unread badge, history list)
//   2. Audit trail (when was it created/sent/read)
//   3. Retry logic (sentAt=null means not yet pushed)
model Notification {
  id String @id @default(uuid()) @db.Uuid

  // Personal notification — always targeted at a specific user
  userId String @db.Uuid
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  // Optional company scope for multi-tenant context
  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Notification type for client-side routing/icons
  // Convention: '{module}.{event}', e.g. 'ledger.created', 'invoice.overdue'
  type String

  // Content
  title String // Push title and in-app heading
  body  String // Push body and in-app description

  // Extra payload for deep-linking on the mobile side
  // e.g. { screen: 'LedgerDetail', entryId: 'uuid' }
  data Json @default("{}")

  // State tracking
  readAt DateTime? // null = unread
  sentAt DateTime? // null = push not yet sent (queued or pending)

  createdAt DateTime @default(now())

  @@index([userId, readAt]) // fast: unread count + filter unread
  @@index([userId, createdAt(sort: Desc)]) // fast: notification feed
  @@index([companyId, createdAt(sort: Desc)]) // fast: company-level queries
}

// ============================================================
// PHASE 3: EXPENSES (المصروفات)
// ============================================================
//
// Design decisions:
// - Each expense belongs to a Company; supplierId is optional (links a vendor).
// - category (ExpenseCategory enum) drives UI grouping and pie-chart analytics.
// - referenceNumber is free-text (receipt / invoice number from vendor).
// - No LedgerEntry link in MVP — expenses live in their own table for simplicity.
//   (A future migration can add a journal-entry bridge if double-entry is needed.)
// - Soft-deleted with isDeleted + deletedAt for full auditability.
// ============================================================

model Expense {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Optional: link to a supplier / vendor this expense was paid to
  supplierId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  category    ExpenseCategory
  amount      Decimal         @db.Decimal(14, 2)
  expenseDate DateTime        @db.Date

  // Human-readable note; stored in the expense itself (not i18n)
  description String? @db.VarChar(500)

  // Optional receipt / vendor invoice reference for physical paper trail
  referenceNumber String? @db.VarChar(100)

  // Cash / bank transfer / cheque / etc. — free text for flexibility
  paymentMethod String? @db.VarChar(100)

  // Extra internal notes (separate from public description)
  notes String? @db.VarChar(1000)

  createdById String @db.Uuid
  createdBy   User   @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Key query patterns:
  // 1. List all expenses for a company sorted by date (default view)
  // 2. Filter by category (category breakdown)
  // 3. Filter by supplier (vendor spend)
  // 4. Date-range reports
  @@index([companyId, isDeleted, expenseDate(sort: Desc)]) // default list
  @@index([companyId, isDeleted, category]) // category filter
  @@index([companyId, isDeleted, supplierId]) // supplier filter
  @@index([companyId, createdAt(sort: Desc)]) // audit sort
}

// ============================================================
// PHASE 4: PRODUCTS / SERVICES CATALOG (كتالوج المنتجات والخدمات)
// ============================================================
//
// Design decisions:
// - `sku` is optional but unique per company when provided.
//   PostgreSQL treats NULLs as distinct in UNIQUE constraints, so multiple
//   products with sku = null are allowed — enforcement happens at the DB level.
// - `category` is a free-text string (not an enum) — merchants have wildly
//   different product taxonomies; a rigid enum would hurt adoption.
// - `isActive` provides soft-disable: hides from catalog pickers without
//   breaking historical data in InvoiceItems (Phase K).
// - `unitPrice` stored at Decimal(14,2) — never do arithmetic in JS/TS.
// - No InvoiceItem relation yet; Phase K will add it via migration.
// - Soft-deleted with isDeleted + deletedAt for full auditability.
// ============================================================

model Product {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(200)
  description String? @db.VarChar(1000)

  // كود المنتج — optional, unique per company (when provided)
  sku String? @db.VarChar(50)

  // Free-text category (e.g. "إلكترونيات", "ملابس", "خدمات") — not an enum by design
  category String? @db.VarChar(100)

  // Unit of measure (قطعة / كيلو / متر / خدمة / etc.) — free-text
  unit String? @db.VarChar(20)

  unitPrice Decimal @db.Decimal(14, 2)

  // Soft disable: hides from catalog picker without removing history
  isActive Boolean @default(true)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  createdById String @db.Uuid
  createdBy   User   @relation("ProductCreatedBy", fields: [createdById], references: [id])

  // Phase K: items in invoices that reference this product (snapshot FK — SetNull on delete)
  invoiceItems InvoiceItem[]

  customerPrices CustomerProductPrice[]

  // SKU uniqueness: Postgres UNIQUE treats NULLs as distinct — multiple products
  // with sku = null are allowed; sku conflicts are caught at the app layer first
  // for a friendly Arabic error message before hitting DB.
  @@unique([companyId, sku])
  // Key query patterns:
  // 1. Active product catalog (default view in picker)
  // 2. Filter by category
  // 3. Name search (ILIKE)
  @@index([companyId, isDeleted, isActive]) // catalog list: active only
  @@index([companyId, isDeleted, category]) // category filter
  @@index([companyId, isDeleted, name]) // name search support
  @@index([companyId, isDeleted, sku]) // SKU search support (B3)
}

// ============================================================
// CustomerProductPrice — P2-BE-1
// ============================================================
// Stores a negotiated/custom price for a specific product when
// sold to a specific customer.  Overrides unitPrice during
// invoice creation if present.
// ============================================================
model CustomerProductPrice {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String   @db.Uuid
  customer   Customer @relation("CustomerProductPrices", fields: [customerId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  price Decimal @db.Decimal(14, 2)

  updatedById String @db.Uuid
  updatedBy   User   @relation("CustomerProductPriceUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, customerId, productId])
  @@index([companyId, customerId]) // all prices for a customer
  @@index([companyId, productId]) // all customers using a product
  @@map("customer_product_prices")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  scope          String            @db.VarChar(120)
  operationType  String            @db.VarChar(80)
  actorUserId    String            @db.Uuid
  companyId      String            @db.Uuid
  idempotencyKey String            @db.VarChar(128)
  requestHash    String            @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  errorCode      String?           @db.VarChar(120)
  lockedUntil    DateTime?
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([companyId, operationType, idempotencyKey])
  @@index([expiresAt])
  @@index([companyId, operationType, status])
  @@map("idempotency_records")
}

// ============================================================
// PHASE K: INVOICES (الفواتير)
// ============================================================

enum InvoiceStatus {
  DRAFT // حفظ مسودة — no financial effect
  PENDING_APPROVAL // أُرسلت للاعتماد — no financial effect yet
  APPROVED // معتمدة — ledger entry + balance created
  REJECTED // مرفوضة — no financial effect
  CANCELLED // ملغاة — ledger entry + balance reversed (if was APPROVED)
}

// Per-invoice payment tracking (B5).
// Separate from the subscription PaymentStatus enum (line 81).
// Only meaningful for APPROVED invoices — DRAFT/REJECTED/CANCELLED stay UNPAID by convention.
enum InvoicePaymentStatus {
  UNPAID // لم تُسدَّد — no payments received
  PARTIAL // مسددة جزئيًا — paidAmount > 0 but < totalAmount
  PAID // مسددة بالكامل — paidAmount >= totalAmount
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

// ============================================================
//
// Design decisions:
// - Invoice stores a snapshot of party data (name, phone, address) at
//   creation time so the document remains accurate even if the party record
//   changes later.
// - InvoiceItem holds a snapshot of description + prices. productId is a
//   soft link for historical traceability; deleting a product NULLs it out
//   (SetNull) without breaking existing invoices.
// - invoiceNumber is server-assigned (INV-YYYY-NNNN). Generation runs inside
//   a $transaction to prevent duplicates under concurrent writes. A unique
//   constraint per company enforces DB-level integrity.
// - deferredSaleId is an optional @unique FK: one sale → at most one invoice.
//   Cancelling (soft-deleting) the invoice does NOT reverse the deferred sale.
// - taxAmount is stored separately so the net and gross totals are clear.
// - Soft-delete only for full auditability.
// ============================================================

model Invoice {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Human-readable number: INV-2026-0001 (server-assigned, unique per company)
  invoiceNumber String @db.VarChar(20)

  // Optional: generated from a deferred sale — at most one invoice per sale
  deferredSaleId String?       @unique @db.Uuid
  deferredSale   DeferredSale? @relation(fields: [deferredSaleId], references: [id], onDelete: SetNull)

  // Workflow status — financial effects (ledger + balance) only applied on APPROVED
  status InvoiceStatus @default(DRAFT)

  // LedgerEntry created when this invoice is APPROVED (manual invoices only).
  // null for DRAFT/PENDING/REJECTED/CANCELLED and all DeferredSale-generated invoices.
  ledgerEntryId String? @db.Uuid

  // Snapshot of party data at invoice creation time
  // (party details may change later — the invoice must remain accurate)
  partyType    PartyType
  partyId      String    @db.Uuid
  partyName    String    @db.VarChar(200)
  partyPhone   String?   @db.VarChar(20)
  partyAddress String?   @db.VarChar(500)

  items InvoiceItem[]

  // Financial totals — server-computed from items + tax
  // Rule: totalAmount = SUM(items[].total) + taxAmount
  totalAmount Decimal @db.Decimal(14, 2)
  taxAmount   Decimal @default(0.00) @db.Decimal(14, 2)

  // Payment tracking (B5) — only meaningful for APPROVED invoices
  paidAmount           Decimal              @default(0.00) @db.Decimal(14, 2)
  invoicePaymentStatus InvoicePaymentStatus @default(UNPAID)

  notes     String?   @db.VarChar(1000)
  issueDate DateTime  @db.Date
  dueDate   DateTime? @db.Date // B2.3 — payment due date for ageing/overdue queries

  createdById String @db.Uuid
  createdBy   User   @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Key query patterns:
  // 1. All invoices for a company sorted by issueDate desc (default view)
  // 2. Invoices for a specific party (customer statement / supplier ledger)
  // 3. Lookup by invoice number (search / sharing)
  @@unique([companyId, invoiceNumber]) // DB-level dedup guard
  @@index([companyId, isDeleted, issueDate(sort: Desc)]) // default list
  @@index([companyId, isDeleted, status]) // status filter (workflow tabs)
  @@index([companyId, isDeleted, partyType, partyId]) // party invoices
  @@index([companyId, isDeleted, invoicePaymentStatus]) // unpaid invoice queries (B5)
  @@index([companyId, isDeleted, partyType, partyId, issueDate(sort: Desc)]) // last invoices for party (B4)
  @@index([companyId, isDeleted, partyId, status]) // B2.2 — snapshot: open invoices per party
  @@index([companyId, isDeleted, dueDate]) // B2.3 — overdue/ageing queries
  @@index([companyId, createdAt(sort: Desc)]) // audit sort
}

// One row per line-item in an invoice.
// Values are frozen snapshots — independent from any catalog changes after creation.
model InvoiceItem {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Soft link to product catalog. SetNull on delete keeps invoice intact.
  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshot values (frozen at creation — never updated after the fact)
  description String  @db.VarChar(500)
  quantity    Decimal @db.Decimal(10, 3) // supports fractional units (e.g. 1.5 kg)
  unitPrice   Decimal @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2) // quantity × unitPrice (server-verified on create)

  @@index([invoiceId])
  @@index([productId]) // B12.4 — frequent-products query
}

// ============================================================
// B01: AUTHORITATIVE GENERAL LEDGER FOUNDATION
// ============================================================

model AccountingTemplate {
  id                  String    @id @default(uuid()) @db.Uuid
  code                String    @db.VarChar(40)
  version             Int
  countryCode         String    @db.Char(2)
  name                String    @db.VarChar(160)
  description         String?   @db.VarChar(1000)
  defaultCurrencyCode String?   @db.Char(3)
  defaultCurrency     Currency? @relation("AccountingTemplateDefaultCurrency", fields: [defaultCurrencyCode], references: [code], onDelete: Restrict)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts AccountingTemplateAccount[]
  setups   AccountingSetup[]

  @@unique([code, version])
  @@index([countryCode, isActive])
}

model AccountingTemplateAccount {
  id                     String                      @id @default(uuid()) @db.Uuid
  templateId             String                      @db.Uuid
  template               AccountingTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stableKey              String                      @db.VarChar(80)
  code                   String                      @db.VarChar(40)
  arabicName             String                      @db.VarChar(200)
  englishName            String                      @db.VarChar(200)
  accountType            AccountingAccountType
  parentId               String?                     @db.Uuid
  parent                 AccountingTemplateAccount?  @relation("AccountingTemplateHierarchy", fields: [parentId, templateId], references: [id, templateId], onDelete: Restrict)
  children               AccountingTemplateAccount[] @relation("AccountingTemplateHierarchy")
  allowDirectPosting     Boolean                     @default(true)
  isControlAccount       Boolean                     @default(false)
  reconciliationEligible Boolean                     @default(false)
  systemKey              String?                     @db.VarChar(80)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@unique([id, templateId])
  @@unique([templateId, stableKey])
  @@index([templateId, parentId])
  @@index([templateId, systemKey])
}

model AccountingAccount {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code                   String                @db.VarChar(40)
  name                   String                @db.VarChar(200)
  accountType            AccountingAccountType
  currencyCode           String?               @db.Char(3)
  currency               Currency?             @relation("AccountingAccountCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  parentId               String?               @db.Uuid
  parent                 AccountingAccount?    @relation("AccountingAccountHierarchy", fields: [parentId, companyId], references: [id, companyId], onDelete: Restrict)
  children               AccountingAccount[]   @relation("AccountingAccountHierarchy")
  isActive               Boolean               @default(true)
  allowDirectPosting     Boolean               @default(true)
  isControlAccount       Boolean               @default(false)
  reconciliationEligible Boolean               @default(false)
  templateCode           String?               @db.VarChar(40)
  templateVersion        Int?
  templateKey            String?               @db.VarChar(80)
  archivedAt             DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  journalLines                JournalLine[]
  openingBalanceLines         OpeningBalanceLine[]
  configurationDefaults       AccountingConfigurationAccount[]
  customerReceivableOverrides CustomerProfile[]                @relation("CustomerReceivableOverride")
  supplierPayableOverrides    SupplierProfile[]                @relation("SupplierPayableOverride")

  @@unique([id, companyId])
  @@unique([companyId, code])
  @@unique([companyId, templateKey])
  @@index([companyId, parentId])
  @@index([companyId, accountType, isActive])
}

model AccountingJournal {
  id           String                @id @default(uuid()) @db.Uuid
  companyId    String                @db.Uuid
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String                @db.VarChar(40)
  name         String                @db.VarChar(200)
  type         AccountingJournalType
  currencyCode String?               @db.Char(3)
  currency     Currency?             @relation("AccountingJournalCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  entries               JournalEntry[]
  configurationDefaults AccountingConfigurationJournal[]

  @@unique([id, companyId])
  @@unique([companyId, code])
  @@index([companyId, type, isActive])
}

model FiscalYear {
  id        String           @id @default(uuid()) @db.Uuid
  companyId String           @db.Uuid
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String           @db.VarChar(40)
  startDate DateTime         @db.Date
  endDate   DateTime         @db.Date
  status    FiscalYearStatus @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  periods   AccountingPeriod[]
  sequences AccountingEntrySequence[]

  @@unique([id, companyId])
  @@unique([companyId, name])
  @@index([companyId, startDate, endDate])
}

model AccountingPeriod {
  id           String                 @id @default(uuid()) @db.Uuid
  companyId    String                 @db.Uuid
  company      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId String                 @db.Uuid
  fiscalYear   FiscalYear             @relation(fields: [fiscalYearId, companyId], references: [id, companyId], onDelete: Restrict)
  name         String                 @db.VarChar(80)
  startDate    DateTime               @db.Date
  endDate      DateTime               @db.Date
  status       AccountingPeriodStatus @default(OPEN)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  journalEntries        JournalEntry[]
  openingBalanceBatches OpeningBalanceBatch[]

  @@unique([id, companyId])
  @@unique([companyId, fiscalYearId, name])
  @@index([companyId, startDate, endDate, status])
}

model AccountingEntrySequence {
  companyId    String     @db.Uuid
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId String     @db.Uuid
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId, companyId], references: [id, companyId], onDelete: Cascade)
  nextValue    Int        @default(1)
  updatedAt    DateTime   @updatedAt

  @@id([companyId, fiscalYearId])
}

model JournalEntry {
  id                 String            @id @default(uuid()) @db.Uuid
  companyId          String            @db.Uuid
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalId          String            @db.Uuid
  journal            AccountingJournal @relation(fields: [journalId, companyId], references: [id, companyId], onDelete: Restrict)
  accountingPeriodId String            @db.Uuid
  accountingPeriod   AccountingPeriod  @relation(fields: [accountingPeriodId, companyId], references: [id, companyId], onDelete: Restrict)

  entryNumber             String               @db.VarChar(40)
  status                  JournalEntryStatus   @default(DRAFT)
  postingDate             DateTime             @db.Date
  documentDate            DateTime?            @db.Date
  dueDate                 DateTime?            @db.Date
  transactionCurrencyCode String               @db.Char(3)
  transactionCurrency     Currency             @relation("JournalEntryTransactionCurrency", fields: [transactionCurrencyCode], references: [code], onDelete: Restrict)
  exchangeRate            Decimal              @db.Decimal(19, 8)
  documentReference       String?              @db.VarChar(120)
  description             String               @db.VarChar(500)
  sourceType              JournalSourceType
  sourceId                String?              @db.Uuid
  idempotencyKey          String               @db.VarChar(128)
  requestHash             String               @db.Char(64)
  postedById              String?              @db.Uuid
  postedBy                User?                @relation("AccountingEntryPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  postedAt                DateTime?
  reversalOfEntryId       String?              @db.Uuid
  reversalOf              JournalEntry?        @relation("JournalEntryReversal", fields: [reversalOfEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  reversals               JournalEntry[]       @relation("JournalEntryReversal")
  openingBalanceBatch     OpeningBalanceBatch? @relation("OpeningBalanceBatchJournalEntry")
  reversalReason          String?              @db.VarChar(500)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  lines JournalLine[]

  @@unique([id, companyId])
  @@unique([companyId, entryNumber])
  @@unique([companyId, sourceType, idempotencyKey])
  @@unique([companyId, reversalOfEntryId])
  @@index([companyId, postingDate])
  @@index([companyId, journalId, postingDate])
  @@index([companyId, sourceType, sourceId])
  @@index([companyId, status])
  @@index([companyId, accountingPeriodId])
}

model OpeningBalanceBatch {
  id                 String                    @id @default(uuid()) @db.Uuid
  companyId          String                    @db.Uuid
  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  effectiveDate      DateTime                  @db.Date
  accountingPeriodId String                    @db.Uuid
  accountingPeriod   AccountingPeriod          @relation(fields: [accountingPeriodId, companyId], references: [id, companyId], onDelete: Restrict)
  status             OpeningBalanceBatchStatus @default(DRAFT)
  description        String                    @db.VarChar(500)
  createdById        String                    @db.Uuid
  createdBy          User                      @relation("OpeningBalanceBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedById         String?                   @db.Uuid
  postedBy           User?                     @relation("OpeningBalanceBatchPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  journalEntryId     String?                   @db.Uuid
  journalEntry       JournalEntry?             @relation("OpeningBalanceBatchJournalEntry", fields: [journalEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  idempotencyKey     String                    @db.VarChar(128)
  requestHash        String                    @db.Char(64)
  validatedAt        DateTime?
  postedAt           DateTime?
  reversedAt         DateTime?
  reversalReason     String?                   @db.VarChar(500)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  lines OpeningBalanceLine[]

  @@unique([id, companyId])
  @@unique([companyId, idempotencyKey])
  @@unique([companyId, journalEntryId])
  @@unique([journalEntryId, companyId])
  @@index([companyId, status, effectiveDate])
}

model OpeningBalanceLine {
  id                String              @id @default(uuid()) @db.Uuid
  companyId         String              @db.Uuid
  batchId           String              @db.Uuid
  batch             OpeningBalanceBatch @relation(fields: [batchId, companyId], references: [id, companyId], onDelete: Cascade)
  accountId         String              @db.Uuid
  account           AccountingAccount   @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: Restrict)
  businessPartnerId String?             @db.Uuid
  businessPartner   BusinessPartner?    @relation(fields: [businessPartnerId, companyId], references: [id, companyId], onDelete: Restrict)
  debit             Decimal             @db.Decimal(19, 4)
  credit            Decimal             @db.Decimal(19, 4)
  description       String?             @db.VarChar(500)
  createdAt         DateTime            @default(now())

  @@unique([id, companyId])
  @@index([companyId, batchId])
  @@index([companyId, accountId])
  @@index([companyId, businessPartnerId])
}

model JournalLine {
  id                      String            @id @default(uuid()) @db.Uuid
  companyId               String            @db.Uuid
  company                 Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntryId          String            @db.Uuid
  journalEntry            JournalEntry      @relation(fields: [journalEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  accountId               String            @db.Uuid
  account                 AccountingAccount @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: Restrict)
  debit                   Decimal           @db.Decimal(19, 4)
  credit                  Decimal           @db.Decimal(19, 4)
  transactionDebit        Decimal           @db.Decimal(19, 4)
  transactionCredit       Decimal           @db.Decimal(19, 4)
  description             String?           @db.VarChar(500)
  businessPartnerId       String?           @db.Uuid
  businessPartner         BusinessPartner?  @relation(fields: [businessPartnerId, companyId], references: [id, companyId], onDelete: Restrict)
  dueDate                 DateTime?         @db.Date
  documentReference       String?           @db.VarChar(120)
  reconciliationReference String?           @db.VarChar(160)
  taxCode                 String?           @db.VarChar(40)
  taxTreatmentCode        String?           @db.VarChar(40)
  taxRate                 Decimal?          @db.Decimal(9, 4)
  createdAt               DateTime          @default(now())

  @@index([companyId, accountId])
  @@index([companyId, journalEntryId])
  @@index([companyId, businessPartnerId])
  @@index([accountId, createdAt])
}

model AccountingConfiguration {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String    @unique @db.Uuid
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  baseCurrencyCode      String    @db.Char(3)
  baseCurrency          Currency  @relation("AccountingBaseCurrency", fields: [baseCurrencyCode], references: [code], onDelete: Restrict)
  reportingCurrencyCode String?   @db.Char(3)
  reportingCurrency     Currency? @relation("AccountingReportingCurrency", fields: [reportingCurrencyCode], references: [code], onDelete: Restrict)
  countryCode           String    @db.Char(2)
  localeCode            String    @db.VarChar(20)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accountDefaults AccountingConfigurationAccount[]
  journalDefaults AccountingConfigurationJournal[]

  @@unique([id, companyId])
}

model AccountingSetup {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @unique @db.Uuid
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status          AccountingSetupStatus @default(NOT_CONFIGURED)
  templateCode    String                @db.VarChar(40)
  templateVersion Int
  template        AccountingTemplate    @relation(fields: [templateCode, templateVersion], references: [code, version], onDelete: Restrict)
  lastError       String?               @db.VarChar(2000)
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([id, companyId])
  @@index([status])
}

// B01.1: canonical currency reference data. The accounting engine validates
// transaction precision from minorUnitPrecision while keeping GL storage at
// four decimal places for deterministic conversion and reporting.
model Currency {
  code               String   @id @db.Char(3)
  name               String   @db.VarChar(100)
  nativeName         String?  @db.VarChar(100)
  symbol             String?  @db.VarChar(12)
  minorUnitPrecision Int
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  accountingAccounts      AccountingAccount[]       @relation("AccountingAccountCurrency")
  accountingJournals      AccountingJournal[]       @relation("AccountingJournalCurrency")
  journalEntries          JournalEntry[]            @relation("JournalEntryTransactionCurrency")
  baseConfigurations      AccountingConfiguration[] @relation("AccountingBaseCurrency")
  reportingConfigurations AccountingConfiguration[] @relation("AccountingReportingCurrency")
  templateDefaults        AccountingTemplate[]      @relation("AccountingTemplateDefaultCurrency")
  customerPreferences     CustomerProfile[]         @relation("CustomerPreferredCurrency")
  supplierPreferences     SupplierProfile[]         @relation("SupplierPreferredCurrency")
  companies               Company[]                 @relation("CompanyCurrency")

  @@index([isActive])
}

model AccountingConfigurationAccount {
  id              String                     @id @default(uuid()) @db.Uuid
  companyId       String                     @db.Uuid
  configurationId String                     @db.Uuid
  configuration   AccountingConfiguration    @relation(fields: [configurationId, companyId], references: [id, companyId], onDelete: Cascade)
  settingKey      AccountingConfigAccountKey
  accountId       String                     @db.Uuid
  account         AccountingAccount          @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([id, companyId])
  @@unique([companyId, configurationId, settingKey])
  @@index([companyId, accountId])
}

model AccountingConfigurationJournal {
  id              String                     @id @default(uuid()) @db.Uuid
  companyId       String                     @db.Uuid
  configurationId String                     @db.Uuid
  configuration   AccountingConfiguration    @relation(fields: [configurationId, companyId], references: [id, companyId], onDelete: Cascade)
  settingKey      AccountingConfigJournalKey
  journalId       String                     @db.Uuid
  journal         AccountingJournal          @relation(fields: [journalId, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([id, companyId])
  @@unique([companyId, configurationId, settingKey])
  @@index([companyId, journalId])
}
