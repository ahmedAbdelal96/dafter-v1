  arReconciliation              ARReconciliation?            @relation(fields: [arReconciliationId, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt                     DateTime                     @default(now())

  @@unique([id, companyId])
  @@unique([arReconciliationId, companyId])
  @@unique([companyId, customerPaymentId, journalLineId])
  @@index([companyId, journalLineId])
  @@index([companyId, customerPaymentId])
}

model ARReconciliation {
  id                       String                     @id @default(uuid()) @db.Uuid
  companyId                String                     @db.Uuid
  company                  Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  debitJournalLineId       String                     @db.Uuid
