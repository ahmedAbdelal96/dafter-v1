  updatedAt    DateTime   @updatedAt

  @@id([companyId, fiscalYearId])
}

model SupplierPayment {
  id                      String                @id @default(uuid()) @db.Uuid
  companyId               String                @db.Uuid
  company                 Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartnerId       String                @db.Uuid
  businessPartner         BusinessPartner       @relation(fields: [businessPartnerId, companyId], references: [id, companyId], onDelete: Restrict)
  status                  SupplierPaymentStatus @default(DRAFT)
  paymentNumber           String?               @db.VarChar(40)
  paymentDate             DateTime              @db.Date
  postingDate             DateTime?             @db.Date
  method                  SupplierPaymentMethod
  sourceAccountId         String                @db.Uuid
  sourceAccount           AccountingAccount     @relation("SupplierPaymentSourceAccount", fields: [sourceAccountId, companyId], references: [id, companyId], onDelete: Restrict)
  payableAccountId        String                @db.Uuid
  payableAccount          AccountingAccount     @relation("SupplierPaymentPayableAccount", fields: [payableAccountId, companyId], references: [id, companyId], onDelete: Restrict)
  transactionCurrencyCode String                @db.Char(3)
  transactionCurrency     Currency              @relation("SupplierPaymentTransactionCurrency", fields: [transactionCurrencyCode], references: [code], onDelete: Restrict)
  exchangeRate            Decimal               @db.Decimal(19, 8)
  amount                  Decimal               @db.Decimal(19, 4)
  unappliedAmount         Decimal               @db.Decimal(19, 4)
  notes                   String?               @db.VarChar(2000)
  reference               String?               @db.VarChar(200)
  journalEntryId          String?               @db.Uuid
  journalEntry            JournalEntry?         @relation("SupplierPaymentJournalEntry", fields: [journalEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  apJournalLineId         String?               @db.Uuid
  apJournalLine           JournalLine?          @relation("SupplierPaymentAPSourceLine", fields: [apJournalLineId, companyId], references: [id, companyId], onDelete: Restrict)
  reversalJournalEntryId  String?               @db.Uuid
  reversalJournalEntry    JournalEntry?         @relation("SupplierPaymentReversalJournalEntry", fields: [reversalJournalEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  idempotencyKey          String?               @db.VarChar(128)
  requestHash             String?               @db.Char(64)
  createdById             String                @db.Uuid
  createdBy               User                  @relation("SupplierPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedById              String?               @db.Uuid
  postedBy                User?                 @relation("SupplierPaymentPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  reversedById            String?               @db.Uuid
  reversedBy              User?                 @relation("SupplierPaymentReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  postedAt                DateTime?
  reversedAt              DateTime?
  reversalReason          String?               @db.VarChar(500)
  reversalIdempotencyKey  String?               @db.VarChar(128)
  reversalRequestHash     String?               @db.Char(64)

  allocations     SupplierPaymentAllocation[]
  reconciliations APReconciliation[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@unique([id, companyId])
  @@unique([companyId, paymentNumber])
  @@unique([companyId, idempotencyKey])
  @@unique([journalEntryId, companyId])
  @@unique([apJournalLineId, companyId])
  @@unique([reversalJournalEntryId, companyId])
  @@unique([companyId, reversalIdempotencyKey])
  @@index([companyId, status, paymentDate])
  @@index([companyId, businessPartnerId, paymentDate])
  @@index([companyId, payableAccountId])
}

model SupplierPaymentAllocation {
  id                            String                          @id @default(uuid()) @db.Uuid
  companyId                     String                          @db.Uuid
  company                       Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
