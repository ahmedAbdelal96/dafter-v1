  POSTED
  REVERSED
}

enum JournalSourceType {
  MANUAL_JOURNAL
  OPENING_BALANCE
  SALES_INVOICE
  CUSTOMER_PAYMENT
  PURCHASE_INVOICE
  SUPPLIER_PAYMENT
  EXPENSE
  CASH_TRANSFER
  REVERSAL
