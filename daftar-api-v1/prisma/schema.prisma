// ============================================================
// LEGACY PARTY LEDGER ENGINE
// ============================================================
// Legacy party workflows retain this polymorphic relation temporarily. The
// authoritative B01/B02 JournalLine uses BusinessPartner.businessPartnerId.
// - partyType + partyId (UUID) identifies the party.
// - No FK constraint possible here; enforce existence in service layer.
// - Keep strong index for statements and lookups.
// ============================================================

model LedgerEntry {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  partyType PartyType
  partyId   String    @db.Uuid

  entryType    LedgerEntryType
  signedAmount Decimal         @db.Decimal(14, 2)

  entryDate DateTime  @db.Date
  dueDate   DateTime? @db.Date
  note      String?

  // Phase 2: Sale type classification.
  // null   → regular ledger entry (cash or non-sale)
  // non-null → categorises the entry for frontend display and reporting.
  saleType SaleType?

  createdById String @db.Uuid
  createdBy   User   @relation("LedgerCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Critical indexes for performance (statements, lists, due items):
  @@index([companyId, partyType, partyId, entryDate(sort: Desc), createdAt(sort: Desc)])
  @@index([companyId, dueDate])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([createdById])
}

// Legacy current balance per party. B02 balances are derived from GL/open
// items and never stored on BusinessPartner.
model Balance {
  companyId String    @db.Uuid
  partyType PartyType
  partyId   String    @db.Uuid

  // CURRENT balance (initialized with openingBalance on party create)
  balance Decimal @default(0.00) @db.Decimal(14, 2)

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, partyType, partyId])
  @@index([companyId, partyType])
}

// ============================================================
// AUDIT LOGGING
// ============================================================

model AuditLog {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  actorUserId String @db.Uuid
  actorUser   User   @relation("AuditActor", fields: [actorUserId], references: [id])

  action     String // e.g. "invoice.approve", "invoice.update"
  entityType String // e.g. "Invoice", "Customer"
  entityId   String? @db.Uuid
  metadata   Json    @default("{}")
  diff       Json? // before/after snapshot for tracked fields (price, discount, status…)

  createdAt DateTime @default(now())

  @@index([companyId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action])
}

