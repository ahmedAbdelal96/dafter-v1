{
  "name": "dafter-dashboard",
  "version": "1.0.0",
  "description": "dafter Dashboard - Accounting Management System",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "i18n:check": "node scripts/validate-i18n.mjs",
    "roles:check": "node scripts/check-role-contracts.mjs",
    "contracts:check": "node scripts/check-platform-subscription-contracts.mjs",
    "smoke:invoice:lifecycle": "node scripts/check-invoice-lifecycle-smoke.mjs",
    "smoke:platform:governance": "node scripts/check-platform-governance-smoke.mjs",
    "module:new": "node scripts/create-module-scaffold.mjs",
    "ar:fix-encoding": "node ../scripts/fix-ar-encoding.js",
    "ar:fix-encoding:dry": "node ../scripts/fix-ar-encoding.js --dry-run --verbose",
    "ci:local": "npm run contracts:check && npm run roles:check && npm run i18n:check && npm run lint && npm run build",
    "build": "npm run i18n:check && next build",
    "start": "next start",
    "lint": "npm run contracts:check && npm run roles:check && npm run i18n:check && eslint ."
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/list": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@hookform/resolvers": "^3.9.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@types/js-cookie": "^3.0.6",
    "apexcharts": "^4.7.0",
    "autoprefixer": "^10.4.22",
    "axios": "^1.13.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "flatpickr": "^4.6.13",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.563.0",
    "next": "16.0.10",
    "next-intl": "^4.7.0",
    "react": "^19.2.0",
    "react-apexcharts": "^1.8.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.71.0",
    "sonner": "^2.0.7",
    "swiper": "^11.2.10",
    "tailwind-merge": "^2.6.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  }
}
