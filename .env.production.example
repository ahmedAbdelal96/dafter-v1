# ============================================================
# Daftar v1 — Production Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git
# ============================================================

# ──────────────────────────────
# PostgreSQL
# ──────────────────────────────
POSTGRES_DB=daftar_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ──────────────────────────────
# Redis (leave empty = no auth)
# ──────────────────────────────
REDIS_PASSWORD=CHANGE_ME_OR_LEAVE_EMPTY

# ──────────────────────────────
# JWT (min 32 chars, random)
# Generate: openssl rand -base64 48
# ──────────────────────────────
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_JWT_SECRET

# ──────────────────────────────
# App URLs
# ──────────────────────────────
CORS_ORIGINS=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME=Daftar

# ──────────────────────────────
# Sentry (optional)
# Get DSN from: sentry.io → Project → Settings → Client Keys
# ──────────────────────────────
SENTRY_DSN=
SENTRY_ENABLED=true
